# Copy to .env and fill in ONLY when Phase 2 (private read-only) starts.
# Milestone 1 needs NO credentials.
#
# API key permissions MUST be: Reading=ON, Spot Trading=ON (later),
# IDR Withdrawal=OFF, Crypto Withdrawal=OFF.

INDODAX_API_KEY=
INDODAX_API_SECRET=

# paper | live  (live is never enabled automatically)
TRADING_MODE=paper

# Only the designated production machine may set this to true.
IS_PRODUCTION_INSTANCE=false

LOG_LEVEL=INFO
